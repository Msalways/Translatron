{
  "name": "translatronx",
  "version": "2.1.0",
  "description": "Deterministic, incremental, build-time translation compiler using LLMs",
  "type": "module",
  "bin": {
    "translatronx": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist",
    "prepare": "husky install",
    "commitlint": "commitlint --edit"
  },
  "keywords": [
    "translation",
    "i18n",
    "localization",
    "llm",
    "compiler",
    "incremental"
  ],
  "author": "",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "dependencies": {
    "@anthropic-ai/sdk": "^0.71.2",
    "@langchain/core": "^1.2.12",
    "@langchain/langgraph": "^1.4.17",
    "@langchain/openai": "^1.5.13",
    "better-sqlite3": "^11.10.0",
    "chalk": "^5.6.2",
    "cli-progress": "^3.12.0",
    "commander": "^12.1.0",
    "cosmiconfig": "^9.0.2",
    "deepagents": "^1.14.0",
    "fast-glob": "^3.3.3",
    "groq-sdk": "^0.37.0",
    "langchain": "^1.5.12",
    "nodejs-polars": "^0.18.0",
    "openai": "^4.104.0",
    "ora": "^8.2.0",
    "picocolors": "^1.1.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^10.3.5",
    "@semantic-release/npm": "^12.0.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/cli-progress": "^3.11.6",
    "@types/node": "^22.20.4",
    "@typescript-eslint/eslint-plugin": "^8.70.1",
    "@typescript-eslint/parser": "^8.70.1",
    "@vitest/coverage-v8": "^2.1.9",
    "@vitest/ui": "^2.1.9",
    "eslint": "^9.39.5",
    "fast-check": "^4.10.2",
    "husky": "^9.1.7",
    "rimraf": "^6.1.3",
    "semantic-release": "^24.2.9",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "overrides": {
    "brace-expansion": {
      "balanced-match": "1.0.2"
    }
  }
}
