{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TranslationRevision",
  "description": "Durable translation lineage record (REVISION_SCHEMA_VERSION 1). Mirrors TranslationRevisionSchema in src/core/domain.ts.",
  "type": "object",
  "required": ["id", "catalogId", "keyPath", "sourceLocale", "targetLocale", "sourceHash", "targetHash", "origin", "parentIds", "runId", "createdAt"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "catalogId": { "type": "string", "minLength": 1 },
    "keyPath": { "type": "string", "minLength": 1 },
    "sourceLocale": { "type": "string", "minLength": 2 },
    "targetLocale": { "type": "string", "minLength": 2 },
    "sourceHash": { "type": "string", "minLength": 1 },
    "targetHash": { "type": "string", "minLength": 1 },
    "origin": { "enum": ["agent", "human", "imported"] },
    "parentIds": { "type": "array", "items": { "type": "string" } },
    "model": { "type": "string" },
    "provider": { "type": "string" },
    "corePolicyFingerprint": { "type": "string" },
    "skillFingerprints": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "scope", "fingerprint"],
        "properties": {
          "id": { "type": "string" },
          "scope": { "type": "string" },
          "fingerprint": { "type": "string" }
        }
      }
    },
    "glossaryFingerprint": { "type": "string" },
    "contextFingerprint": { "type": "string" },
    "runId": { "type": "string", "minLength": 1 },
    "createdAt": { "type": "string", "format": "date-time" }
  }
}
